<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入习惯"
            android:textColor="@color/word"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chkFourUnique"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="四码唯一自动上屏"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/chkEmptyClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="四码空码自动清空"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/chkEnterClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="回车清码（不上屏编码）"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/chkComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="候选显示编码提示"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/chkAutoSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="登录后自动同步用户词"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/syncHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAccount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_copy"
            android:text="同步账号"
            android:textColor="@color/word" />

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_bar"
            android:text="用法"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
