<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_bar"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:text="五笔"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <cn.kylebing.bbq10wubi.ui.WubiEditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg"
        android:gravity="top|left"
        android:hint="在此打五笔，再复制出去"
        android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
        android:padding="10dp"
        android:textColor="@color/word"
        android:textColorHint="@color/text_dim"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/composeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/preeditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/candScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/langBadge"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_bar"
            android:minWidth="56dp"
            android:text="中"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_copy"
            android:text="复制"
            android:textColor="@color/word"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bar"
            android:text="清空"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/btn_bar"
            android:minWidth="56dp"
            android:text="…"
            android:textColor="@color/text"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
