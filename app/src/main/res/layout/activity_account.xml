<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="门户账号"
            android:textColor="@color/word"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="邮箱"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:textColor="@color/word"
                android:textColorHint="@color/text_dim" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="密码"
                android:inputType="textPassword"
                android:textColor="@color/word"
                android:textColorHint="@color/text_dim" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_copy"
                android:text="登录"
                android:textColor="@color/word"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="用户词"
                android:textColor="@color/word"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUpload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_bar"
                android:text="上传覆盖云端"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_bar"
                android:text="下载覆盖本地"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMerge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_bar"
                android:text="合并（保留两边独有）"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCompare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_bar"
                android:text="对比本地 / 云端"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="扩展词库"
                android:textColor="@color/word"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExtra"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_bar"
                android:text="从云端拉取扩展词库"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_bar"
                android:text="退出登录"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <include layout="@layout/include_home_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/syncLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
